# Enforce dependencies' declared "engines" ranges rather than warning about them.
#
# Note what this does NOT do: npm applies engine-strict to packages it installs,
# not to the root project's own "engines" range. Verified — `npm ci` on Node 25
# with engines ">=22 <23" exits 0 silently. The root pin is enforced instead by
# scripts/check-node.mjs, wired to preinstall.
#
# The Node version itself lives in .nvmrc, which CI reads via
# actions/setup-node's node-version-file. One source of truth, both sides.
engine-strict=true
