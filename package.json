{
  "name": "strength-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "setup-hooks": "git config core.hooksPath .githooks && echo 'hooks enabled: .githooks (pre-push runs npm run verify)'",
